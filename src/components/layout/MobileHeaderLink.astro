---
export interface Props {
  href: string;
  text: string;
}

const { href, text } = Astro.props;
---

<a
  href={href}
  class='hover:text-gdgoc-primary-blue dark:hover:text-gdgoc-primary-blue block rounded-lg py-2 font-medium text-gray-700 transition-colors duration-200 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800'
>
  {text}
</a>

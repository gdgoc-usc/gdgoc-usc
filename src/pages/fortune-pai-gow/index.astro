---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import SlotMachine from '@/components/slots/SlotMachine.astro';
import { Image } from 'astro:assets';
---

<Layout
  title='Fortune Pai Gow - GDGoC USC Team Slots'
  description='Meet our amazing team members through this fun interactive slot machine game!'
>
  <Header />
  <main class='flex min-h-screen w-full bg-white px-4 pt-16 dark:bg-gray-800'>
    <div class='container mx-auto max-w-6xl pt-8'>
      <div class='mb-4 text-center'>
        <div class='mb-6 flex justify-center'>
          <Image
            src='/gdgoc_logo.svg'
            alt='GDGoC Logo'
            width={80}
            height={80}
            class='h-16 w-16 md:h-20 md:w-20'
          />
        </div>
        <h1
          class='mb-4 text-4xl font-bold tracking-tight text-black md:text-6xl dark:text-white'
        >
          <span class='text-gdgoc-primary-blue'>Fortune</span>
          <span class='text-gdgoc-primary-red'>Pai</span>
          <span class='text-gdgoc-primary-yellow'>Gow</span>
        </h1>
        <p class='mb-2 text-xl text-black md:text-2xl dark:text-gray-300'>
          Meet Our Amazing Team Members!
        </p>
        <p
          class='mx-auto max-w-2xl text-base text-gray-800 md:text-lg dark:text-gray-400'
        >
          Pull the lever and discover one of our talented GDGoC USC team
          members.
        </p>
      </div>

      <SlotMachine />

      <div class='mt-12 mb-8 text-center'>
        <div class='mx-auto max-w-4xl p-6'>
          <h3
            class='mb-3 text-lg font-semibold text-gray-800 dark:text-gray-200'
          >
            📢 Important Disclaimer
          </h3>
          <div class='space-y-2 text-sm text-black dark:text-gray-400'>
            <p>
              <strong>This is NOT a gambling site.</strong> This is a fun, educational
              tool designed to introduce you to our amazing GDGoC USC team members.
            </p>
            <p>
              No real money, betting, or gambling is involved. This is purely
              for entertainment and team introduction purposes.
            </p>
            <p>
              We promote responsible digital citizenship and do not endorse
              gambling activities.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { getAllMembersWithImages } from '@/utils/teamUtils';

  if (typeof window !== 'undefined') {
    window.getAllMembersWithImages = getAllMembersWithImages;
  }
</script>

<style>
  .glass-card {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 20px;
    border: 2px solid rgba(0, 0, 0, 0.1);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  html.dark .glass-card {
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }
</style>

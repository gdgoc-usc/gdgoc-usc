---
import { Image } from 'astro:assets';
---

<div class='my-16'>
  <div class='mb-12 text-center'>
    <h2
      class='from-gdgoc-primary-blue via-gdgoc-primary-green to-gdgoc-primary-yellow mb-4 bg-gradient-to-r bg-clip-text text-3xl font-bold text-transparent md:text-4xl'
    >
      Our Events & Activities
    </h2>
    <p class='mx-auto max-w-2xl text-lg text-gray-600 dark:text-gray-300'>
      Engaging experiences that bring our community together and foster learning
    </p>
  </div>

  <div class='mx-auto grid max-w-6xl gap-8 md:grid-cols-3'>
    <div
      class='group from-gdgoc-primary-blue/5 to-gdgoc-secondary-blue/5 border-gdgoc-primary-blue/20 hover:border-gdgoc-primary-blue/40 hover:shadow-gdgoc-primary-blue/10 relative overflow-hidden rounded-2xl border bg-gradient-to-br transition-all duration-300 hover:shadow-xl'
    >
      <div class='aspect-video overflow-hidden rounded-t-2xl'>
        <Image
          src='/events/ideathon.jpg'
          alt='GDGoC USC Ideathon - Students collaborating on innovative ideas'
          width={400}
          height={225}
          class='h-full w-full object-cover transition-transform duration-300 group-hover:scale-105'
        />
      </div>
      <div class='p-6'>
        <h3
          class='text-gdgoc-primary-blue dark:text-gdgoc-secondary-blue mb-2 text-xl font-bold'
        >
          Ideathon
        </h3>
        <p class='text-sm leading-relaxed text-gray-600 dark:text-gray-300'>
          Collaborative brainstorming sessions where students generate
          innovative solutions to real-world problems.
        </p>
      </div>
    </div>

    <div
      class='group from-gdgoc-primary-green/5 to-gdgoc-secondary-green/5 border-gdgoc-primary-green/20 hover:border-gdgoc-primary-green/40 hover:shadow-gdgoc-primary-green/10 relative overflow-hidden rounded-2xl border bg-gradient-to-br transition-all duration-300 hover:shadow-xl'
    >
      <div class='aspect-video overflow-hidden rounded-t-2xl'>
        <Image
          src='/events/infosession.jpg'
          alt='GDGoC USC Information Session - Introduction to our community'
          width={400}
          height={225}
          class='h-full w-full object-cover transition-transform duration-300 group-hover:scale-105'
        />
      </div>
      <div class='p-6'>
        <h3
          class='text-gdgoc-primary-green dark:text-gdgoc-secondary-green mb-2 text-xl font-bold'
        >
          Info Session
        </h3>
        <p class='text-sm leading-relaxed text-gray-600 dark:text-gray-300'>
          Welcome sessions introducing new members to our community, goals, and
          upcoming opportunities.
        </p>
      </div>
    </div>

    <div
      class='group from-gdgoc-primary-yellow/5 to-gdgoc-primary-orange/5 border-gdgoc-primary-yellow/20 hover:border-gdgoc-primary-yellow/40 hover:shadow-gdgoc-primary-yellow/10 relative overflow-hidden rounded-2xl border bg-gradient-to-br transition-all duration-300 hover:shadow-xl'
    >
      <div class='aspect-video overflow-hidden rounded-t-2xl'>
        <Image
          src='/events/techfortomorow.jpg'
          alt='Tech for Tomorrow - Future-focused technology discussions'
          width={400}
          height={225}
          class='h-full w-full object-cover transition-transform duration-300 group-hover:scale-105'
        />
      </div>
      <div class='p-6'>
        <h3
          class='text-gdgoc-primary-yellow dark:text-gdgoc-primary-orange mb-2 text-xl font-bold'
        >
          Tech for Tomorrow
        </h3>
        <p class='text-sm leading-relaxed text-gray-600 dark:text-gray-300'>
          Forward-thinking workshops exploring emerging technologies and their
          impact on society.
        </p>
      </div>
    </div>
  </div>
</div>

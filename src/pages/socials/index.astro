---
import ThemeSwitcher from '@/components/ThemeSwitcher';
import SocialLinkCard from '@/components/SocialLinkCard';
import { socialLinks } from '@/config/social.data';
import SocialsLayout from '@/layouts/SocialsLayout.astro';
---

<SocialsLayout
  title='GDGoC USC - Google Developer Groups on Campus'
  description='Join the Google Developer Groups on Campus at University of San Carlos. Learn, build, and connect with fellow developers.'
>
  <body
    class='min-h-screen bg-gradient-to-br from-white via-gray-50 to-blue-50 transition-colors duration-300 dark:bg-black'
  >
    <div class='absolute top-4 right-4 z-10'>
      <ThemeSwitcher client:load />
    </div>

    <div class='flex min-h-screen items-center justify-center px-4 py-8'>
      <div class='mx-auto w-full max-w-md space-y-8'>
        <div class='space-y-4 text-center'>
          <div class='mx-auto h-24 w-24 rounded-full bg-black p-[0.1rem]'>
            <div
              class='flex h-full w-full items-center justify-center overflow-hidden rounded-full bg-white dark:bg-black'
            >
              <img
                src='/new_logo.svg'
                alt='GDG on Campus USC Logo'
                class='h-16 w-16 object-contain'
              />
            </div>
          </div>

          <div class=''>
            <h1 class='text-2xl font-extrabold text-black dark:text-white'>
              Google Developer Groups
            </h1>
            <p class='text-sm leading-relaxed text-gray-600 dark:text-gray-300'>
              University of San Carlos
            </p>
          </div>
        </div>

        <div class='flex flex-col gap-4 space-y-2'>
          {
            socialLinks.map(social => (
              <SocialLinkCard social={social} client:load />
            ))
          }
        </div>

        <!-- Footer -->
        <div class='pt-4 text-center'>
          <p class='text-xs text-gray-500 dark:text-gray-400'>
            © 2025 Google Developer Groups on Campus - University of San Carlos
          </p>
        </div>
      </div>
    </div>
  </body>
</SocialsLayout>

---
import '@/styles/team-masonry.css';
import Header from '@/components/layout/Header.astro';
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/layout/Footer.astro';
import TeamGrid from '@/components/team/TeamGrid';
import YearSelector from '@/components/team/YearSelector';
import { Image } from 'astro:assets';
import {
  getTeamDataForYear,
  getYearLabel,
  availableYears,
} from '@/config/team-manager';

export async function getStaticPaths() {
  return availableYears.map(year => ({
    params: { year: year.id },
  }));
}

const { year } = Astro.params;
const teamData = await getTeamDataForYear(year!);
const yearLabel = getYearLabel(year!);
---

<Layout
  title={`GDGoC USC - Our Team ${yearLabel}`}
  description={`Meet our amazing team members from ${yearLabel}!`}
>
  <Header />

  <section
    id='team'
    class='relative flex min-h-screen w-full flex-col items-center justify-center bg-white py-12 dark:bg-black'
    style='background-image: url(/gdgoc_bg_1.webp); background-size: cover; background-position: center; background-attachment: fixed;'
  >
    <div class='absolute inset-0 z-0 bg-white/0 dark:bg-black/0'></div>
    <div
      class='relative z-10 container mt-[2rem] w-full px-4 sm:px-6 lg:px-8 sm:md:lg:xl:mt-[4rem]'
    >
      <div class='w-full'>
        <div class='flex justify-center sm:md:lg:xl:mb-4'>
          <Image
            src='/gdgoc_logo.svg'
            alt='GDGoC Logo'
            width={80}
            height={80}
            class='h-24 w-24 md:h-20 md:w-20'
          />
        </div>
        <div class='text-center'>
          <div class='flex flex-col gap-2'>
            <h1
              class='mb-4 text-4xl font-bold tracking-tighter text-black md:text-6xl dark:text-white'
            >
              Our Team
            </h1>
          </div>
          <p
            class='mx-auto mb-4 max-w-4xl text-xl leading-relaxed text-gray-700 sm:text-2xl md:text-3xl dark:text-gray-200'
          >
            Meet the dedicated leaders driving innovation and community
          </p>
        </div>
      </div>
      <div class='flex justify-center'>
        <YearSelector client:load currentYear={year!} />
      </div>
    </div>
    <TeamGrid client:load teamData={teamData} />
  </section>

  <Footer />
</Layout>

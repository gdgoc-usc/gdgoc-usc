---
import GridMotion from '@/components/react-bits/GridMotion';
import { Image } from 'astro:assets';
const items = [
  // Row 1
  '/events/brewingvanilla.jpg',
  '/events/ideathon.jpg',
  '/events/devmaycry.jpg',
  '/events/devmaycry2.jpg',
  '/events/infosession.jpg',
  '/events/techfortomorow.jpg',
  '/events/gitonboard.jpg',
  // Row 2
  '/events/pythonquest.jpg',
  '/events/reactnative.jpg',
  '/events/tagyoureout.jpg',
  '/events/brewingvanilla.jpg',
  '/events/ideathon.jpg',
  '/events/devmaycry.jpg',
  '/events/devmaycry2.jpg',
  // Row 3
  '/events/infosession.jpg',
  '/events/techfortomorow.jpg',
  '/events/gitonboard.jpg',
  '/events/pythonquest.jpg',
  '/events/reactnative.jpg',
  '/events/tagyoureout.jpg',
  '/events/brewingvanilla.jpg',
  // Row 4
  '/events/ideathon.jpg',
  '/events/devmaycry.jpg',
  '/events/devmaycry2.jpg',
  '/events/infosession.jpg',
  '/events/techfortomorow.jpg',
  '/events/gitonboard.jpg',
  '/events/pythonquest.jpg',
  '/events/reactnative.jpg',
  '/events/tagyoureout.jpg',
];
---

<section
  id='about'
  class='relative flex min-h-screen w-full flex-col items-center justify-center overflow-hidden py-12'
>
  <div class='absolute inset-0 z-1'>
    <div class='absolute inset-0 bg-white dark:bg-neutral-900'>
      <div class='absolute inset-0 opacity-10 dark:opacity-10'>
        <div class='h-full w-full'>
          <GridMotion items={items} client:load client:only />
        </div>
      </div>
    </div>
  </div>
  <div class='absolute inset-0 z-2'></div>
  <div class='relative z-10 container w-full px-4 sm:px-6 lg:px-8'>
    <div class='w-full'>
      <div class='mb-8 text-center'>
        <div class='flex flex-col gap-2'>
          <Image
            src='/gdgoc_logo.svg'
            alt='GDGoC Logo'
            width={128}
            height={128}
            class='mt-2 h-24 w-24 sm:mx-auto sm:mt-0 sm:mb-6 md:h-32 md:w-32'
          />
          <h1
            class='mb-4 flex flex-row items-center justify-center text-left text-4xl font-bold tracking-tighter text-black md:text-6xl dark:text-white'
          >
            Google Developer Groups
          </h1>
        </div>
        <p
          class='mx-auto mb-4 max-w-4xl text-left text-xl leading-relaxed text-gray-700 sm:text-2xl md:text-3xl sm:md:text-center dark:text-gray-200'
        >
          <strong class='text-gdgoc-primary-blue dark:text-gdgoc-secondary-blue'
            >Google Developer Group - University of San Carlos</strong
          >
          is a hub mainly for student developers. We offer a supportive environment
          where students can connect with like-minded peers, fostering a space for
          collaboration and growth.
        </p>

        <div class='mx-auto max-w-4xl rounded-xl border-1 border-black p-4'>
          <p class='text-base leading-relaxed text-gray-600 dark:text-gray-300'>
            Through workshops, talks, and project-building activities, students
            can gain expertise in the latest technologies, empowering them to
            turn innovative ideas into impactful solutions that address
            real-world challenges.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
